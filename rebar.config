%% base_dir keeps every build artefact under target/, which main's .gitignore
%% already ignores -- so `git status` stays clean on this branch without
%% touching a shared file. target/gen/hc_data.hrl is generated by build.sh and
%% carries the page template, the index URL and the OG card as base64
%% literals, so they are compiled into the .beam files rather than read from
%% disk at runtime.
{erl_opts, [debug_info, warnings_as_errors, {i, "target/gen"}]}.
{base_dir, "target/_build"}.

{deps, [{cowboy, "2.13.0"}]}.

{relx, [
    {release, {hello_cloud, "1.0.0"}, [hello_cloud]},
    {mode, prod},
    {include_erts, true},
    {extended_start_script, true}
]}.
