<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The executable Laravel Cloud starts has to be called app. -->
    <AssemblyName>app</AssemblyName>
    <RootNamespace>HelloCloud</RootNamespace>
    <!-- NativeAOT, not single-file: a single-file publish still unpacks its
         native libraries into a writable temp directory at startup, while AOT
         produces one real ELF that needs nothing but glibc. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <OptimizationPreference>Size</OptimizationPreference>
  </PropertyGroup>

  <!-- The shared template, the index URL and the OG card are compiled into the
       assembly, so nothing on Cloud's ephemeral filesystem matters. -->
  <ItemGroup>
    <EmbeddedResource Include="../shared/page.html" LogicalName="page.html" />
    <EmbeddedResource Include="../shared/index-url.txt" LogicalName="index-url.txt" />
    <EmbeddedResource Include="../og.png" LogicalName="og.png" />
  </ItemGroup>

</Project>
