<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven is used here only to RESOLVE jars, not to compile anything: Clojure
  compiles its own source at startup, so the bundle ships the dependency jars
  plus the .clj source on the classpath and needs no uberjar and no AOT step.
  That is why there is no clojure build tool in the picture.

  This file lives in jvm/ and NOT at the branch root on purpose. Laravel Cloud
  reads the branch root to pick a runtime, and a pom.xml there makes it refuse
  the branch outright: "The [clojure] branch ... uses an unsupported framework."

  http-kit and ring live on Clojars rather than Maven Central, hence the extra
  repository.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>build.artisan</groupId>
  <artifactId>hello-cloud</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <repositories>
    <repository>
      <id>clojars</id>
      <url>https://repo.clojars.org</url>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>org.clojure</groupId>
      <artifactId>clojure</artifactId>
      <version>1.12.0</version>
    </dependency>
    <dependency>
      <groupId>http-kit</groupId>
      <artifactId>http-kit</artifactId>
      <version>2.8.0</version>
    </dependency>
    <dependency>
      <groupId>ring</groupId>
      <artifactId>ring-core</artifactId>
      <version>1.12.2</version>
    </dependency>
  </dependencies>

  <build>
    <directory>${project.basedir}/../target/maven</directory>
  </build>
</project>
