<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>hello</AssemblyName>
    <RootNamespace>Hello</RootNamespace>

    <!-- Cloud's runtime image carries no .NET, so the artifact has to be the
         whole thing: one self-contained linux-arm64 file. -->
    <RuntimeIdentifier>linux-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- debian:12 ships no libicu, and this page needs no culture data. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- The template, the index URL and the OG card are assembly resources, so
       the process never touches Cloud's ephemeral filesystem. -->
  <ItemGroup>
    <EmbeddedResource Include="shared/page.html" LogicalName="page.html" />
    <EmbeddedResource Include="shared/index-url.txt" LogicalName="index-url.txt" />
    <EmbeddedResource Include="og.png" LogicalName="og.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

</Project>
