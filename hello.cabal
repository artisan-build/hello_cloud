cabal-version:      2.4
name:               hello
version:            0.1.0.0
synopsis:           Hello from Haskell, on Laravel Cloud
build-type:         Simple
extra-source-files: shared/page.html
                    shared/index-url.txt
                    og.png

executable hello
    main-is:          Main.hs
    hs-source-dirs:   src
    build-depends:    base        >=4.17 && <5
                    , bytestring  >=0.11
                    , text        >=2.0
                    , file-embed  >=0.0.15
                    , http-types  >=0.12
                    , scotty      >=0.21
                    , warp        >=3.3
    default-language: Haskell2010
    ghc-options:      -O2 -threaded -rtsopts "-with-rtsopts=-N2"
